{
  "format_version": "1.8.0",
  "animations": {
    "animation.butterflies.butterfly.fly": {
      "loop": true,
      "bones": {
        "wing_left": {
          "rotation": [
            0,
            0,
            "(q.is_on_ground ? math.sin(q.life_time * 90) * 15 : math.sin(q.life_time * 1500 * v.flap) * (math.sin(q.life_time * 37) > 0.8 ? 12 : 55))"
          ]
        },
        "wing_right": {
          "rotation": [
            0,
            0,
            "-(q.is_on_ground ? math.sin(q.life_time * 90) * 15 : math.sin(q.life_time * 1500 * v.flap) * (math.sin(q.life_time * 37) > 0.8 ? 12 : 55))"
          ]
        },
        "root": {
          "position": [
            0,
            "q.is_on_ground ? 0 : math.sin(q.life_time * 400 * v.flap) * 0.8",
            0
          ]
        },
        "antennae": {
          "rotation": [
            "math.sin(q.life_time * 150) * 4",
            0,
            0
          ]
        }
      }
    },
    "animation.butterflies.caterpillar.crawl": {
      "loop": true,
      "bones": {
        "seg0": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 55))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ]
        },
        "seg1": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 110))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ]
        },
        "seg2": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 165))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ]
        },
        "seg3": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 220))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ]
        },
        "seg4": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 275))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ]
        },
        "tail": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 330))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ]
        },
        "head": {
          "position": [
            0,
            "math.max(0, math.sin(q.life_time * 320 - 0))  * math.clamp(q.modified_move_speed * 8, 0.15, 1.0) * 1.2",
            0
          ],
          "rotation": [
            "math.sin(q.life_time * 160) * 6",
            "math.sin(q.life_time * 70) * 10",
            0
          ]
        }
      }
    },
    "animation.butterflies.chrysalis.sway": {
      "loop": true,
      "bones": {
        "pod": {
          "rotation": [
            "math.sin(q.life_time * 33) * 2",
            0,
            "math.sin(q.life_time * 45) * 4 + (math.sin(q.life_time * 7) > 0.97 ? math.sin(q.life_time * 900) * 6 : 0)"
          ]
        }
      }
    }
  }
}
